{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bindery/v1",
  "title": "Bindery Composition IR (shared core, mainPRD §12.3)",
  "description": "Target-agnostic envelope. A target vocab schema (pptx.schema.json, web.schema.json) narrows `blocks` to its own oneOf of components via allOf + $ref to this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "design_system", "target", "blocks"],
  "properties": {
    "schema": { "const": "bindery/v1" },
    "design_system": { "type": "string", "pattern": "^[a-z0-9_-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "target": { "enum": ["pptx", "web", "infographic", "html-slides"] },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["component", "props"],
        "properties": {
          "component": { "type": "string" },
          "props": { "type": "object" }
        }
      }
    }
  }
}
