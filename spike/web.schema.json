{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bindery.web/v1",
  "title": "Bindery Composition IR (web target vocab, extends bindery/v1)",
  "allOf": [
    { "$ref": "core.schema.json" },
    {
      "properties": {
        "target": { "const": "web" },
        "blocks": {
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/title" },
              { "$ref": "#/$defs/statTrio" },
              { "$ref": "#/$defs/navBar" }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "props"],
      "properties": {
        "component": { "const": "title" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline"],
          "properties": {
            "eyebrow": { "type": "string", "maxLength": 40 },
            "headline": { "type": "string", "maxLength": 90 },
            "accent": { "enum": ["primary", "secondary", "neutral"] }
          }
        }
      }
    },
    "statTrio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "props"],
      "properties": {
        "component": { "const": "stat-trio" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stats"],
          "properties": {
            "stats": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "string", "maxLength": 12 },
                  "label": { "type": "string", "maxLength": 30 },
                  "delta": { "type": "string", "maxLength": 10 },
                  "href": { "type": "string", "maxLength": 200, "format": "uri-reference" }
                }
              }
            }
          }
        }
      }
    },
    "navBar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "props"],
      "properties": {
        "component": { "const": "nav-bar" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["links"],
          "properties": {
            "links": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "href"],
                "properties": {
                  "label": { "type": "string", "maxLength": 30 },
                  "href": { "type": "string", "maxLength": 200, "format": "uri-reference" }
                }
              }
            }
          }
        }
      }
    }
  }
}
